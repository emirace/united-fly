# Copy to .env.local and fill in.
# These are the same values the old flyzone_backend used — there is no longer a
# separate frontend env file, and no VITE_BACKEND / VITE_BACKEND2: the UI and
# the API are served from one origin.

# MongoDB connection string
MONGO_URI=

# Secret used to sign both account and guest-chat JWTs
JWT_SECRET=

# Cloudinary credentials for image uploads (chat attachments, payment receipts,
# profile photos). Find them under Product Environment Credentials in the
# Cloudinary dashboard. Uploads fail without all three.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Fallback mailbox for outbound email. The dashboard Settings screen can
# override these per-deployment (Settings → Email notifications).
EMAIL_USER=
EMAIL_PASS=

# Optional. Canonical public origin used to build shareable payment links
# (e.g. https://unitedfly.example.com). Leave blank to derive it from the
# incoming request, which is correct for most deployments.
NEXT_PUBLIC_SITE_URL=
